            "type": "string"
          },
          "target_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Id"
          },
          "focus_position": {
            "anyOf": [
              {
                "maximum": 40,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Focus Position"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "action",
          "payload"
        ],
        "title": "Propose",
        "type": "object"
      }
    }
  },
