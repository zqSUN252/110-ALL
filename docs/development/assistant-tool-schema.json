[
  {
    "type": "function",
    "function": {
      "name": "query",
      "description": "查询当前授权范围，分页返回事实及未知银行覆盖。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "cases",
              "bank",
              "bank_files",
              "archives",
              "templates",
              "files",
              "cargo",
              "invoices"
            ],
            "title": "Kind",
            "type": "string"
          },
          "query": {
            "default": "",
            "maxLength": 200,
            "title": "Query",
            "type": "string"
          },
          "amount": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Amount"
          },
          "currency": {
            "anyOf": [
              {
                "enum": [
                  "NGN",
                  "USD",
                  "CNY"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Currency"
          },
          "transaction_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Transaction Date"
          },
          "account_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Account Id"
          },
          "offset": {
            "default": 0,
            "maximum": 1000000,
            "minimum": 0,
            "title": "Offset",
            "type": "integer"
          },
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "kind"
        ],
        "title": "Query",
        "type": "object"
      }
    }
  },
  {
